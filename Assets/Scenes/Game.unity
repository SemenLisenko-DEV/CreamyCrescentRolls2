  m_text: "\u041A\u043E\u043D\u0446\u043E\u0432\u043A\u0430: \u0423\u0442\u0435\u0447\u043A\u0430\n\n\u0412\u044B
    \u0431\u044B\u043B\u0438 \u043D\u0435 \u0441\u0430\u043C\u044B\u043C \u043B\u0443\u0447\u0448\u0438\u043C
    \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u043A\u043E\u043C. \u0412\u0430\u0448\u0438
    \u043E\u0448\u0438\u0431\u043A\u0438 \u0438 \u043D\u0435\u043E\u0431\u0434\u0443\u043C\u0430\u043D\u043D\u044B\u0435
